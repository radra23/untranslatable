<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core OTel SDK + hosting integration -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <!-- OTLP exporter replaces deprecated Jaeger exporter -->
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <!-- ASP.NET Core auto-instrumentation (traces + metrics) -->
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Untranslatable.Data\Untranslatable.Data.csproj" />
    <ProjectReference Include="..\Untranslatable.Shared\Untranslatable.Shared.csproj" />
  </ItemGroup>

</Project>
